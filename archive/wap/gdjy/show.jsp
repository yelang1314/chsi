<script>
(function () {
    var qs = location.search.match(/[?&]type=([^&]+)/);
    var type = qs ? qs[1] : 'xl';
    if (type === 'xj') {
        document.getElementById('sub-xj').className = 'active';
        document.getElementById('sub-xl').className = '';
    }
    var titleItem = document.getElementById('titleItem_1');
    if (titleItem) {
        titleItem.textContent = (type === 'xj' ? '高等学籍' : '高等学历') + '-在线验证报告-已申请的报告';
    }
    var tb = document.getElementById('zxyz_table_1');
    var tr = document.createElement('tr');
    tr.innerHTML = '<td colspan="5" class="loading">加载中...</td>';
    tb.appendChild(tr);

    function reportAction(id, action, label) {
        if (action === 'close' && !confirm('确定关闭该报告吗？关闭后将无法在线验证。')) return;
        var body = new URLSearchParams();
        body.append('type', type);
        body.append('id', id);
        body.append('action', action);
        fetch('/api/gdjy/report/action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
            body: body.toString()
        })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (res.success) { alert(label + '成功'); location.reload(); }
                else { alert(label + '失败: ' + (res.message || '')); }
            })
            .catch(function (e) { alert(label + '失败: ' + e.message); });
    }
    window.extendReport = function (id) { reportAction(id, 'extend', '延长验证有效期'); };
    window.closeReport = function (id) { reportAction(id, 'close', '关闭'); };

    fetch('/api/gdjy/show?type=' + encodeURIComponent(type))
        .then(function (r) { return r.json(); })
        .then(function (res) {
            var headTitle = (res.result && res.result.headTitle) || '';
            if (headTitle && titleItem) { titleItem.textContent = headTitle; }
            var list = (res.result && res.result.list) || [];
            tb.innerHTML = '<tr><th width="206">在线验证码</th><th width="130">语种</th><th width="200">有效期</th><th width="200">状态</th><th>操作</th></tr>';
            if (!list.length) {
                var e = document.createElement('tr');
                e.innerHTML = '<td colspan="5" class="empty">暂无已申请的报告</td>';
                tb.appendChild(e);
                return;
            }
            list.forEach(function (it) {
                var url = '/archive/wap/gdjy/report.jsp?type=' + encodeURIComponent(type) + '&id=' + encodeURIComponent(it.id);
                var row = document.createElement('tr');
                row.className = 'hasborder';
                row.innerHTML =
                    '<td><a class="blue" href="' + url + '" target="_blank">' + (it.verifyCode || '') + '</a></td>' +
                    '<td>' + (it.lang || '中文') + '</td>' +
                    '<td>' + (it.validTo || '') + '</td>' +
                    '<td>' + (it.status || '有效') + '</td>' +
                    '<td><a class="blue" href="' + url + '" target="_blank">查看</a><a href="javascript:void(0)" onclick="window.extendReport(\'' + it.id + '\')">延长验证有效期</a><a href="javascript:void(0)" onclick="window.closeReport(\'' + it.id + '\')">关闭</a></td>';
                tb.appendChild(row);
            });
        })
        .catch(function () {
            tb.innerHTML = '<tr><th width="206">在线验证码</th><th width="130">语种</th><th width="200">有效期</th><th width="200">状态</th><th>操作</th></tr>';
            var e = document.createElement('tr');
            e.innerHTML = '<td colspan="5" class="empty">加载失败</td>';
            tb.appendChild(e);
        });
})();
</script>
