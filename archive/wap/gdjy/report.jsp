<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta content="yes" name="apple-mobile-web-app-capable">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no,viewport-fit=cover">
    <meta name="format-detection" content="telephone=no" />
    <title>教育部学历证书电子注册备案表</title>
    <link rel="stylesheet" href="https://t1.chei.com.cn/common/ch/iconfont.css">
    <link rel="stylesheet" href="https://t1.chei.com.cn/common/ch/chicon/iconfont.css">
    <link href="https://t2.chei.com.cn/chsi/assets/gb/wap/css/app.css?v=20260713" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="https://t1.chei.com.cn/common/css/font/RareWords/RareWordsFonts.css">
    <script src="https://t1.chei.com.cn/common/js/vue/2.6.10/vue.min.js"></script>
    <script>
        (function () {
            var docEl = document.documentElement;
            var w = docEl.clientWidth || 375;
            docEl.style.fontSize = w / 10 + 'px';
        })();
    </script>
    <style>
        [v-cloak] { display: none; }
        @font-face {
            font-style: normal;
            font-weight: 400;
            font-family: 'ch-icon';
            src: url(https://t3.chei.com.cn/gaokao/wap/assets/font/vant-icon.woff2) format("woff2"),url(https://t3.chei.com.cn/gaokao/wap/assets/font/vant-icon.woff) format("woff"),url(https://t3.chei.com.cn/gaokao/wap/assets/font/vant-icon.ttf) format("truetype")
        }
        .ch-nav { display: flex; align-items: center; }
        .ch-icon { position: relative; font: normal normal normal 14px/1 'ch-icon'; font-size: inherit; text-rendering: auto; font-size: 0.533rem; -webkit-font-smoothing: antialiased; }
        .ch-icon-cross:before { display: inline-block; content: '\F042'; cursor: pointer; }
        .van-overflow-hidden { overflow: hidden !important; }
        .ch-common-nav-popup .van-popup { position: fixed; width: 100%; max-width: 750px; margin: 0 auto; max-height: 100%; overflow-y: auto; background-color: #fff; transition: transform 0.3s; -webkit-overflow-scrolling: touch; }
        .ch-van-overlay { position: fixed; top: 0; left: 0; z-index: 1; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.7); }
        .ch-common-nav-popup .van-popup--center { top: 50%; left: 50%; transform: translate3d(-50%, -50%, 0); }
        .ch-common-nav-popup .close-bar { height: 1.173rem; padding: 0 0.427rem; display: flex; -ms-flex-align: center; align-items: center; -ms-flex-pack: end; justify-content: space-between; }
        .ch-common-nav-popup .ch-van-overlay { top: 0; left: auto; max-width: 750px; margin: 0 auto; }
        .ch-common-nav-popup .van-popup { top: 0; left: auto; }
        .ch-common-nav-popup .van-popup::after { position: absolute; box-sizing: border-box; content: ' '; pointer-events: none; top: -50%; right: -50%; bottom: -50%; left: -50%; border: 0 solid #e5e5e5; transform: scale(0.5); border-top-width: 1px; border-color: #d5d5d5; }
        .ch-common-nav-popup .van-popup--center { transform: none; }
        .ch-common-nav-popup .van-row { padding: 0.267rem 0.28rem; text-align: center; }
        .ch-common-nav-popup .van-row .active { background: #f5f5f5; }
        .ch-common-nav-popup .van-row a { display: block; height: 0.96rem; line-height: 0.96rem; border-radius: 0.107rem; margin: 0 0.147rem 0.293rem; font-size: 0.373rem; color: #333; background: #f5f5f5; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ch-common-nav-popup .van-row .van-col:nth-child(6) a { padding-left: 0.133rem; }
        .close-bar .logo { display: block; height: 0.704rem; }
        .wap-nav-bar { position: relative; z-index: 1; height: 1.173rem; display: flex; align-items: center; background: #fff; border-bottom: 1px solid #e8eaed; }
        .wap-nav-bar .wap-nav-bar__left { padding: 0 0.427rem; display: flex; align-items: center; }
        .wap-nav-bar .logo { display: block; height: 0.704rem; }
        .wap-nav-bar__center { flex: 1; height: 1.173rem; display: flex; align-items: center; justify-content: flex-end; }
        .wap-nav-bar .wap-nav-bar__right { padding: 0 0.427rem; display: flex; align-items: center; }
        .logo-text { font-size: 0.373rem; color: #60656e; margin-bottom: -0.0534rem; }
        .logo-text a { color: #60656e; text-decoration: none; }
        .logo-dot { display: block; height: 0.533rem; width: 0.027rem; background: #e8eaed; margin: 0 0.213rem; }
        .nav-search { margin-right: 0.32rem; }
        .ch-van-overlay-search { background: #fff; }
        .site-search-wap { display: flex; align-items: center; height: 1.173rem; background: #f7f8fa; padding: 0 0.427rem 0 0.24rem; }
        .top-nav-search-button-wap { outline: none; background: none; border: none; font-size: 0.373rem; padding: 0; margin-left: 0.32rem; color: #131b18; }
        .top-nav-search-input-wap { flex: 1; border: 1px solid #d4d9d7; height: 0.853rem; color: #131b18; background: #fff url(https://t2.chei.com.cn/common/images/icon-search-wap.svg) left 0.21rem center no-repeat; background-size: auto 0.533rem; border-radius: 0.11rem; outline: none; padding: 0 0.21rem 0 0.88rem; box-sizing: border-box; }
        .t_top_nav_notice { line-height: 1.5; font-size: 0.32rem; background-color: #f1f1f1; }
        .t_top_nav_notice > span, .t_top_nav_notice > div { display: inline-block; padding: 0.24rem 0.4rem; }
        .status-box { text-align: center; padding: 1.6rem 0; color: #999; font-size: .4rem; }
    </style>
    <script>
        // 本地化：未登录直接访问，跳转登录页
        if (document.cookie.indexOf('chsi_login=') === -1) {
            var _loc = window.location.pathname + window.location.search;
            window.location.href = '/archive/login.jsp?redirect=' + encodeURIComponent(_loc);
        }
    </script>
</head>
<body class="ch-body" style="font-size: 12px;">

<div class="outer-wrap">
    <div id="app" class="outer-content" v-cloak>
        <top-nav :title="navTitleHtml"></top-nav>

        <div class="res-wrap" v-if="reportState==='valid' && report">
            <div class="card">
                <div class="top-change">
                    <div class="lang-div">
                        报告语种
                        <a href="javascript:;" class="current">中文</a><a href="javascript:;">英文</a>
                    </div>
                    <div title="下载PDF" class="pdf-div" @click="downloadPdf"></div>
                </div>
                <h3 class="res-h3">{{report.title}}</h3>
                <div class="img-div" v-if="photoUrl">
                    <img :src="photoUrl" width="58" data-caption="个人头像">
                </div>
                <div class="rowcard">
                    <div class="row" v-for="(f, i) in fields" :key="i">
                        <div class="col-left">{{f.label}}</div>
                        <div class="col-right">{{f.value}}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="res-wrap error-page lscx-error" v-else-if="reportState==='closed' || reportState==='expired'">
            <div class="msg-icon"></div>
            <div>
                <h2 v-if="reportState==='closed'">在线验证报告已关闭，无法在线验证。</h2>
                <h2 v-else>在线验证报告已过期，无法在线验证。</h2>
                <p v-if="reportState==='closed'">需权属人登录<a href="/archive/wap/archive.jsp">学信档案</a>进行开启。</p>
                <p v-else>需权属人登录<a href="/archive/wap/archive.jsp">学信档案</a>进行延期。</p>
            </div>
        </div>

        <div v-else class="status-box">
            <div v-if="loading">报告加载中…</div>
            <div v-else>暂无报告数据，请先在后台维护报告信息</div>
        </div>
    </div>
</div>

<div class="wap-footer wap-footer2">
    主办单位：<a href="https://chesicc.chsi.com.cn/">教育部学生服务与素质发展中心</a><br>
    Copyright © 2003-2026 <a href="https://www.chsi.com.cn/" target="_blank">学信网</a> All Rights Reserved
</div>

<template id="nav-template">
<div>
    <div class="t_top_nav_notice">
        <div style="display:none;"></div>
    </div>
    <div class="wap-nav-bar">
        <div class="wap-nav-bar__left">
            <a href="/wap/index.jsp">
                <img class="logo" src="https://t3.chei.com.cn/chsi/assets/gb/wap/images/logo.png" alt="学信网">
            </a>
            <template v-if="title!=''">
                <span class="logo-dot"></span>
                <span class="logo-text" v-html="title"></span>
            </template>
        </div>
        <div class="wap-nav-bar__center">
            <slot name="center"></slot>
        </div>
        <div class="wap-nav-bar__right">
            <span v-if='!aliPayFlag' class="nav-search" @click="showSearch = true;">
                <slot name="search-icon">
                    <img src="https://t2.chei.com.cn/common/images/icon-search-wap.svg" style="width: .64rem;display: block;">
                </slot>
            </span>
            <span class="ch-nav" @click="showNav = true;">
                <slot>
                    <img src="https://t1.chei.com.cn/common/images/wap-icon/nav-menu.svg" style="width: .64rem;display: block">
                </slot>
                <div ref="yzpopup" class="ch-common-nav-popup">
                    <template v-if="showNav">
                        <div class="ch-van-overlay" @click="showNav = false;" style="z-index: 2001"></div>
                        <div class="van-popup van-popup--center" style="z-index: 2002">
                            <div class="close-bar">
                                <a href="/wap/index.jsp">
                                    <img class="logo" src="https://t3.chei.com.cn/chsi/assets/gb/wap/images/logo.png" alt="学信网">
                                </a>
                                <i class="ch-icon ch-icon-cross" style="font-size: .64rem;" @click="showNav = false;"></i>
                            </div>
                            <div class="gk-top-navlist">
                                <div class="van-row">
                                    <template v-for="item in navList">
                                        <div :class="{'van-col' : true, 'van-col--8' : true}">
                                            <a :href="item.href" @click="gaTrackerOutboundLink({ eventCategory: '移动端二级导航', eventAction: 'click', eventLabel: item.name }, {trackName:'wapTopNav-click',trackOption: {'点击位置': item.name}})">{{ item.name }}</a>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </template>
                    <template v-if="showSearch">
                        <div class="ch-van-overlay ch-van-overlay-search" style="z-index: 2001"></div>
                        <div class="van-popup van-popup--center" style="z-index: 2002">
                            <form @submit.prevent="searchSubmit" ref="site-search-wap" class="site-search-wap" action="https://cn.bing.com/search" method="get">
                                <img @click="showSearch=false" src="https://t1.chei.com.cn/common/images/icon-back.svg" style="width: .533rem;display: block;margin-right: 0.24rem;">
                                <input type="hidden" class="realQuery" name="q" :value="searchValue + ' site:www.chsi.com.cn'">
                                <input placeholder="" type="text" ref="seachInput" name="query" autocomplete="off" class="top-nav-search-input-wap" v-model.trim="searchValue" maxlength="100">
                                <button type="submit" class="top-nav-search-button-wap">搜索</button>
                            </form>
                        </div>
                    </template>
                </div>
            </span>
        </div>
    </div>
</div>
</template>

<script>
    Vue.component('topNav', {
        props: {
            title: {
                type: String,
                default: ''
            }
        },
        data: function () {
            return {
                searchValue: '',
                showNav: false,
                showSearch: false,
                isWap: typeof wapFn != 'undefined' ? wapFn() : true,
                navList: [
                    { name: '首页', href: '/wap/index.jsp' },
                    { name: '学籍查询', href: '/archive/wap/index.jsp' },
                    { name: '学历查询', href: '/archive/wap/index.jsp' },
                    { name: '学位查询', href: 'https://www.chsi.com.cn/xwcx/index.jsp' },
                    { name: '在线验证', href: 'https://www.chsi.com.cn/xlcx/bgcx.jsp' },
                    { name: '出国教育背景信息服务', href: 'https://www.chsi.com.cn/xlrz/cgjy/' },
                    { name: '图像校对', href: '/archive/wap/index.jsp#txjd' },
                    { name: '学信档案', href: '/archive/wap/archive.jsp' },
                    { name: '高考', href: 'https://gaokao.chsi.com.cn/' },
                    { name: '研招', href: 'https://yz.chsi.com.cn/' },
                    { name: '港澳台招生', href: 'https://www.gatzs.com.cn/' },
                    { name: '征兵', href: 'https://www.gfbzb.gov.cn/' },
                    { name: '就业', href: 'https://www.ncss.cn/' },
                    { name: '学职平台', href: 'https://xz.chsi.com.cn/' }
                ],
                aliPayFlag: false
            };
        },
        methods: {
            gaTrackerOutboundLink: function (params, params2) {
                return true;
            },
            searchSubmit: function () {
                if (!this.searchValue) {
                    alert("请输入关键词");
                    return;
                }
                this.$refs['site-search-wap'].submit();
            }
        },
        mounted: function () {
            var popDom = this.$refs.yzpopup;
            document.body.append(popDom);
            var sUserAgent = navigator.userAgent.toLowerCase();
            if (sUserAgent.indexOf('alipayclient') > -1) {
                this.aliPayFlag = true;
            } else {
                this.aliPayFlag = false;
            }
        },
        watch: {
            showNav: function (val) {
                if (val) {
                    document.body.classList.add('van-overflow-hidden');
                } else {
                    document.body.classList.remove('van-overflow-hidden');
                }
            },
            showSearch: function (val) {
                if (val) {
                    var _this = this;
                    document.body.classList.add('van-overflow-hidden');
                    this.$nextTick(function () {
                        _this.$refs.seachInput.focus();
                    });
                } else {
                    document.body.classList.remove('van-overflow-hidden');
                }
            }
        },
        template: '#nav-template'
    });
</script>

<script>
    new Vue({
        el: '#app',
        data: function () {
            return {
                navTitle: '在线验证报告',
                navTitleHtml: '<a href="https://www.chsi.com.cn/xlcx/bgcx.jsp">在线验证</a>',
                loading: true,
                status: -1,
                reportState: '',
                report: null,
                fields: [],
                photoUrl: '',
                reportType: 'xl',
                reportId: ''
            };
        },
        created: function () {
            var _this = this;
            var qs = window.location.search.replace(/^\?/, '');
            var params = {};
            qs.split('&').forEach(function (kv) {
                var p = kv.split('=');
                if (p[0]) params[decodeURIComponent(p[0])] = decodeURIComponent(p[1] || '');
            });
            var type = params.type || 'xl';
            var id = params.id || '';
            _this.reportType = type;
            _this.reportId = id;
            fetch('/api/gdjy/report?type=' + encodeURIComponent(type) + '&id=' + encodeURIComponent(id))
                .then(function (resp) { return resp.json(); })
                .then(function (res) {
                    _this.loading = false;
                    _this.status = res.status;
                    _this.report = (res.status === 0) ? res.result : null;
                    if (_this.report) {
                        _this.reportState = res.result.reportState || 'valid';
                        _this.navTitle = _this.report.title;
                        if (_this.reportState === 'valid') {
                            document.title = _this.report.title;
                            _this.buildFields(type, id);
                        } else {
                            document.title = '在线验证报告';
                        }
                    }
                })
                .catch(function () {
                    _this.loading = false;
                    _this.status = -1;
                });
        },
        methods: {
            onClickLeft: function () {
                history.back(-1);
            },
            downloadPdf: function () {
                // 由服务端按官方备案表样式生成 PDF 并下载
                var url = '/api/gdjy/report/pdf?type=' + encodeURIComponent(this.reportType)
                    + '&id=' + encodeURIComponent(this.reportId);
                var a = document.createElement('a');
                a.href = url;
                a.download = '';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            },
            buildFields: function (type, id) {
                var info = this.report.info || {};
                var rep = this.report.report || {};
                var v = function (k) { return info[k] || ''; };
                // 与官方手机版报告页字段顺序/名称一致
                var defs;
                if (type === 'xj') {
                    defs = [
                        ['姓名', v('xm')],
                        ['性别', v('xb')],
                        ['出生日期', v('csrq')],
                        ['民族', v('mz')],
                        ['学校名称', v('yxmc')],
                        ['层次', v('cc')],
                        ['专业', v('zymc')],
                        ['学制', v('xz')],
                        ['学历类别', v('xllb')],
                        ['学习形式', v('xxxs')],
                        ['分院', v('fy')],
                        ['系所', v('xsh')],
                        ['入学日期', v('rxrq')],
                        ['学籍状态', v('xjzt')],
                        ['离校日期', v('byrq')]
                    ];
                    // 头像：优先录取照片 lqPic
                    this.photoUrl = info.hasLqPic
                        ? ('/archive/photo/lqpic.do?pid=' + encodeURIComponent(id) + '&v=' + (info.lqPicVer || ''))
                        : (info.hasXlPic ? ('/archive/photo/xlpic.do?pid=' + encodeURIComponent(id) + '&v=' + (info.xlPicVer || '')) : '');
                } else {
                    defs = [
                        ['姓名', v('xm')],
                        ['性别', v('xb')],
                        ['出生日期', v('csrq')],
                        ['入学日期', v('rxrq')],
                        ['毕（结）业日期', v('byrq')],
                        ['学校名称', v('yxmc')],
                        ['专业', v('zymc')],
                        ['学制', v('xz')],
                        ['层次', v('cc')],
                        ['学历类别', v('xllb')],
                        ['学习形式', v('xxxs')],
                        ['毕（结）业', v('bjyjl')],
                        ['证书编号', v('zsbh')],
                        ['校（院）长姓名', v('xzm')]
                    ];
                    this.photoUrl = info.hasXlPic
                        ? ('/archive/photo/xlpic.do?pid=' + encodeURIComponent(id) + '&v=' + (info.xlPicVer || '')) : '';
                }
                defs.push(['在线验证码', rep.verifyCode || '']);
                defs.push(['更新日期', rep.validFrom || '']);
                this.fields = defs.map(function (d) { return { label: d[0], value: d[1] }; });
            }
        }
    });
</script>
</body>
</html>
